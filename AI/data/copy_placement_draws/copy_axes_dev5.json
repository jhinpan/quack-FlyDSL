  "band_test": {
    "512MiB": {
      "band": [
        4.885,
        4.895
      ],
      "band_convention": "half-open [lo, hi) under a nearest / half-up display rule: a true value of 4.895 displays as 4.90, not 4.89, so it cannot have produced the historical cell. Convention fixed by @Reviewer in 4d6ed9de; stated here because a bare pair reads as closed and an earlier version of this artifact published one.",
      "band_width_pct_of_lo": 0.205,
      "n_draws": 80,
      "draws_below_band": 12,
      "draws_inside_band_half_open": 0,
      "draws_inside_band_closed": 0,
      "draws_at_or_above_band_half_open": 68,
      "min_below_and_max_above_band": true,
      "why_not_called_straddled": "an earlier version of this field was named band_is_straddled, which reads as 'this protocol can produce a value in the band'. The data do not show that and cannot: see band_reachability_power. All the boolean states is that the minimum draw is below the band and the maximum is at or above it, which is also true of any distribution with a hole where the band sits. @Autotune raised this against the 512 MiB artifact and it applied here too.",
      "all_draws_unrounded": true,
      "no_undecidable_draws": "every draw here is stored unrounded, so unlike the 512-MiB-only artifact there is no draw whose band membership the record cannot decide"
    },
