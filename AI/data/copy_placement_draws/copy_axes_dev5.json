      "uniform_model_ILLUSTRATIVE_NOT_MEASURED_POWER": {
        "p_single_slot_in_band": 0.0113,
        "expected_slot_means_in_band": 0.225,
        "p_at_least_one_in_band_pct": 20.3,
        "why_not_load_bearing": "treats five fixed ordinals under four selected prefixes as iid uniform draws over the span, and divides relative widths taken about different denominators. @Reviewer, 5c2e0083. The conclusion below does not use it."
      },
      "band_width_vs_single_draw_noise": {
        "estimator": "min of seven timing rounds, as published",
        "n_cells_with_repeats": 20,
